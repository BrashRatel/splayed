{
  "version": "0.1.0-pre-alpha.1",
  "nodeModulesDir": "auto",
  "tasks": {
    "cli": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run main.ts",
    "test": "deno test --allow-net=127.0.0.1 --allow-read --allow-write --allow-env --allow-run",
    "check": "deno check main.ts src/ tests/",
    "regtest": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run=docker tests/integration/dev_env.ts",
    "test:integration": "deno test --allow-net=127.0.0.1 --allow-read --allow-write --allow-env --allow-run=docker tests/integration/regtest.integration.ts",
    "lint": "deno lint",
    "fetch-tor": "deno run --allow-net=archive.torproject.org --allow-read --allow-write --allow-run=tar scripts/fetch_tor.ts",
    "update-tor-manifest": "deno run --allow-net=archive.torproject.org --allow-read --allow-write --allow-run=gpg scripts/update_tor_manifest.ts",
    "ui": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run main.ts ui --open",
    "compile": "deno compile --allow-net --allow-read --allow-write --allow-env --allow-run --include src/ui/static -o dist/forksplit main.ts",
    "demo-ui": "deno run -A tests/demo_ui.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false,
    "exclude": [
      "src/ui/static/vendor/"
    ]
  },
  "lint": {
    "include": [
      "main.ts",
      "src/",
      "tests/",
      "scripts/"
    ],
    "exclude": [
      "src/ui/static/vendor/"
    ]
  },
  "exclude": [
    "node_modules/"
  ]
}
